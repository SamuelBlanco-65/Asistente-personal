# Frontend (mobile/.env or .env)
EXPO_PUBLIC_BACKEND_URL=http://100.90.110.69:8000

# Backend (backend/.env or .env)
APP_NAME="JARVIS Student AI Backend"
ENVIRONMENT="development"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Database
DB_PATH=jarvis_student.db

# Optional OAuth Credentials (Managed ONLY in Backend)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
